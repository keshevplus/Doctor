{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/reclaim-holds",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/expire-credits",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "app/api/transcribe/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/ai/**/route.ts": {
      "maxDuration": 60
    }
  }
}
