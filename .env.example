# ---------------------------------------------------------------------------
# Reel — environment variables
#
# Copy to .env.local for development. In production every one of these is set
# in the Vercel dashboard (Project → Settings → Environment Variables), never
# committed. Values marked SENSITIVE must be Vercel "Sensitive" variables so
# they cannot be read back out of the dashboard after being set.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
# Canonical origin. Used for WebAuthn relying-party checks, OAuth callbacks and
# Stripe redirect URLs. Must exactly match the browser origin or passkeys fail.
APP_URL="http://localhost:3000"

# --- Auth.js --------------------------------------------------------------
# SENSITIVE. Generate with: openssl rand -base64 32
# Rotating this invalidates every active session, which is the intended
# emergency lever if you suspect session compromise.
AUTH_SECRET=""
# Vercel sets this automatically; leave unset locally.
AUTH_TRUST_HOST="true"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""       # SENSITIVE
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""       # SENSITIVE

# Magic-link fallback delivery (Resend).
AUTH_RESEND_KEY=""          # SENSITIVE
AUTH_EMAIL_FROM="Reel <login@reel.app>"

# --- Database -------------------------------------------------------------
# Neon pooled connection string. SENSITIVE.
# Must be the *pooled* endpoint (-pooler in the host) — serverless functions
# open far more connections than a direct endpoint tolerates.
DATABASE_URL=""

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=""        # SENSITIVE
STRIPE_WEBHOOK_SECRET=""    # SENSITIVE — from `stripe listen` or the dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Storage --------------------------------------------------------------
# Vercel Blob, for uploaded note audio. SENSITIVE.
BLOB_READ_WRITE_TOKEN=""

# --- AI providers ---------------------------------------------------------
# Credit-consuming features. SENSITIVE.
ANTHROPIC_API_KEY=""
TRANSCRIPTION_API_KEY=""

# --- Cron -----------------------------------------------------------------
# SENSITIVE. Vercel sends this as `Authorization: Bearer $CRON_SECRET` on
# scheduled invocations; the handlers reject anything else.
CRON_SECRET=""
